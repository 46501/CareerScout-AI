{
  "name": "careerscout-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Your AI-powered career opportunity scout.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @careerscout/api\" \"npm run dev -w web\" \"npm run dev -w @careerscout/worker\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
